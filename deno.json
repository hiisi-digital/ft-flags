{
  "name": "@hiisi/ft-flags",
  "version": "0.2.1",
  "description": "Feature flags for TypeScript with Cargo-style feature definitions, conditional compilation, and CLI tooling.",
  "license": "MPL-2.0",
  "exports": {
    ".": "./mod.ts",
    "./cli": "./src/cli.ts",
    "./manifest": "./src/manifest.ts",
    "./schema": "./schema.json"
  },
  "bin": {
    "ft": "./src/cli.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0",
    "@hiisi/viola": "jsr:@hiisi/viola@^0.3.1",
    "@hiisi/viola-default-lints": "jsr:@hiisi/viola-default-lints@^0.3.1",
    "@hiisi/viola-grammar-ts": "jsr:@hiisi/viola-grammar-ts@^0.3.1"
  },
  "lint": {
    "include": [
      "**/*.ts"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "camelcase",
        "default-param-last",
        "eqeqeq",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "no-await-in-loop",
        "no-console",
        "no-const-assign",
        "no-eval",
        "no-implicit-declare-namespace-export",
        "no-non-null-asserted-optional-chain",
        "no-self-compare",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "prefer-ascii",
        "single-var-declarator",
        "verbatim-module-syntax"
      ],
      "exclude": [
        "no-console"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "include": [
      "**/*.ts",
      "*.md"
    ]
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env --allow-run --allow-net",
    "test:watch": "deno test --allow-read --allow-write --allow-env --allow-run --allow-net --watch",
    "lint": "deno run -A --min-dep-age=0 jsr:@hiisi/viola-cli@^0.3.1 --project . --include src,mod.ts",
    "lint:fix": "deno lint --fix",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check mod.ts src/cli.ts src/manifest.ts",
    "all": "deno task fmt && deno task lint && deno task check && deno task test",
    "prepublish": "deno task all",
    "ft": "deno run --allow-read --allow-env src/cli.ts",
    "build:npm": "deno run -A scripts/build_npm.ts",
    "publish:npm": "cd npm && npm publish",
    "bench": "deno bench --allow-read benches/"
  },
  "publish": {
    "include": [
      "mod.ts",
      "src/**/*.ts",
      "schema.json",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "tests/",
      "scripts/",
      ".githooks/",
      "npm/"
    ]
  },
  "repository": "https://github.com/hiisi-digital/ft-flags",
  "distDir": "target",
  "dist": {
    "node": {
      "runtime": "node",
      "versions": [
        "20",
        "22",
        "24"
      ],
      "plugins": [
        {
          "id": "deno-to-node",
          "options": {
            "cjs": false,
            "shims": {
              "deno": true
            }
          }
        }
      ]
    },
    "bun": {
      "runtime": "bun",
      "versions": [
        "latest"
      ],
      "plugins": [
        "deno-to-bun"
      ]
    },
    "deno": {
      "runtime": "deno",
      "versions": [
        "v2.x"
      ],
      "plugins": [
        "deno-passthrough"
      ]
    }
  },
  "minimumDependencyAge": 0
}
